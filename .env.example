# Content stage. "demo" allows unconfirmed content; "production" enforces the
# content gate (npm run validate:production) and disables the concept ribbon.
SITE_STAGE=demo

# Canonical origin. Every canonical URL, Open Graph URL and sitemap entry is
# derived from this single value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Concept ribbon. Off by default so the demo presents as a finished site;
# set to "true" while reviewing to show the "pending client confirmation" note.
NEXT_PUBLIC_SHOW_DEMO_BANNER=false

# Photography source. Default (unset) serves the stock photos from the Unsplash
# CDN. Run `npm run photos` to download them into public/images/, then set this
# to "local" to serve them from your own origin.
NEXT_PUBLIC_PHOTO_SOURCE=

# Enquiry delivery. "disabled" transmits nothing and reports honestly.
# Implement an adapter in src/lib/enquiry-delivery.ts before changing this.
CONTACT_DELIVERY_PROVIDER=disabled

# Destination for enquiries once a delivery adapter is configured.
CONTACT_RECIPIENT_EMAIL=

# Unsplash API access key, used only by scripts/select-unsplash-photos.mjs at
# build time. Server-side only — never referenced from client code.
UNSPLASH_ACCESS_KEY=
